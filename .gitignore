vendor/
portal/log
portal/tmp

### Portal
# Ignore bundler config.
/portal/.bundle
/portal/vendor/bundle

# Ignore the default SQLite database.
/portal/db/*.sqlite3
/portal/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/portal/log/*
!/portal/log/.keep
/portal/tmp
.vagrant

# Local profiling results
/log/

# Generated image files (the database remains the source of truth)
/webapp/public/image/
